# Public build-time setting. Never put a Turnstile SECRET here.
VITE_TURNSTILE_SITE_KEY=""

# Existing public Supabase configuration (the current client retains its configured project).
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# All provider secrets belong in Supabase > Edge Functions > Secrets:
# GEMINI_API_KEY, GEMINI_MODEL, TURNSTILE_SECRET_KEY
# EMAILJS_PRIVATE_KEY, EMAILJS_PUBLIC_KEY, EMAILJS_SERVICE_ID, EMAILJS_TEMPLATE_ID
# ALLOWED_ORIGINS (comma-separated exact HTTPS origins)
# Never use VITE_GEMINI_API_KEY or put provider credentials into frontend files.
